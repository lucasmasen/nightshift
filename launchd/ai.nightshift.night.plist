<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs one whole Nightshift night at 2:00am every day (or when the Mac next wakes): real calls to the demo line,
     simulated calls, then the morning email. Installed 11/17 with Lucas's OK. Spends up to ~$1.50 of the $2/day
     simulator cap plus up to $1.50 of model usage on HarnessRouter. Never puts anything live.
     Remove:  launchctl unload ~/Library/LaunchAgents/ai.nightshift.night.plist && rm ~/Library/LaunchAgents/ai.nightshift.night.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>ai.nightshift.night</string>
  <key>WorkingDirectory</key><string>/Users/lucasmasen/AI Infrastructure Claude/nightshift</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string><string>-m</string><string>nightshift</string><string>nightly</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/Users/lucasmasen/AI Infrastructure Claude/nightshift/runs/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/lucasmasen/AI Infrastructure Claude/nightshift/runs/launchd.log</string>
</dict></plist>
